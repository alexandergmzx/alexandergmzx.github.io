{% assign rates = site.data.teaching_rates %}
{% if rates and rates.services %}
  <style>
    #teaching-estimator .form-select,
    #teaching-estimator .form-control {
      background-color: var(--global-card-bg-color);
      color: var(--global-text-color);
      border-color: var(--global-divider-color, rgba(128, 128, 128, 0.3));
    }
    #teaching-estimator .form-select:focus,
    #teaching-estimator .form-control:focus {
      background-color: var(--global-card-bg-color);
      color: var(--global-text-color);
      border-color: var(--global-theme-color);
      box-shadow: 0 0 0 0.2rem rgba(var(--global-theme-color-rgb, 128, 128, 128), 0.25);
    }
    #teaching-estimator .form-label {
      color: var(--global-text-color);
    }
  </style>

  <script id="teaching-estimator-data" type="application/json">
    {
      "currency": {{ rates.currency | default: "USD" | jsonify }},
      "groupDiscount": {
        "threshold": {{ rates.group_discount.threshold | default: 3 }},
        "multiplier": {{ rates.group_discount.multiplier | default: 1 }}
      },
      "services": [
        {% for s in rates.services %}
          {
            "id": {{ s.id | jsonify }},
            "label": {{ s.label | jsonify }},
            "unitLabel": {{ s.unit_label | default: "units" | jsonify }},
            "rate": {% if s.rate == nil %}null{% else %}{{ s.rate }}{% endif %},
            "groupPricing": {% if s.group_pricing %}true{% else %}false{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>

  <form id="teaching-estimator" class="row g-3 align-items-end" autocomplete="off">
    <div class="col-md-7">
      <label for="estimator-service" class="form-label">Service</label>
      <select id="estimator-service" class="form-select">
        {% for s in rates.services %}
          <option value="{{ s.id }}">{{ s.label }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="col-md-5">
      <label for="estimator-quantity" class="form-label">
        <span id="estimator-quantity-label">Quantity</span>
      </label>
      <input type="number" id="estimator-quantity" class="form-control" min="1" step="1" value="1">
    </div>

    <div class="col-12">
      <div
        id="estimator-result"
        role="status"
        aria-live="polite"
        style="
          background: var(--global-card-bg-color);
          color: var(--global-text-color);
          border: 1px solid var(--global-divider-color, rgba(128, 128, 128, 0.3));
          border-radius: 0.375rem;
          padding: 0.85rem 1rem;
        "
      >
        <strong>Estimated total:</strong>
        <span id="estimator-total">—</span>
        <div class="small mt-1" style="color: var(--global-text-color-light);" id="estimator-note"></div>
      </div>
    </div>
  </form>

  <p class="small mt-2" style="color: var(--global-text-color-light);">
    Estimates are a guideline — the exact quote depends on scope. Confirm on a short intro call.
  </p>

  <script defer src="{{ '/assets/js/teaching-estimator.js' | relative_url | bust_file_cache }}"></script>
{% else %}
  <p style="color: var(--global-text-color-light);">Estimator unavailable — populate <code>_data/teaching_rates.yml</code>.</p>
{% endif %}
