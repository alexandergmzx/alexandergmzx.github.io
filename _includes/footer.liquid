{% capture footer_contents %}
<div class="footer-row"><span>&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</span><nav class="footer-links" aria-label="Contact"><a href="https://github.com/{{ site.data.socials.github_username }}">GitHub ↗</a><a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn ↗</a><a href="{{ '/feed.xml' | relative_url }}">RSS ↗</a></nav></div>
<div class="footer-meta">{{ site.footer_text }}{% if site.last_updated %} Updated {{ site.time | date: '%B %Y' }}.{% endif %}{% if site.impressum_path %} <a href="{{ site.impressum_path | relative_url }}">Impressum</a>.{% endif %}</div>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
