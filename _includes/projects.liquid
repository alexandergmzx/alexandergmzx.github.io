{% assign project_href = project.url | relative_url %}
{% if project.redirect %}
  {% assign project_href = project.redirect %}
{% endif %}
<article class="project-entry{% if project.img %} project-entry-with-image{% endif %}">
  {% if project.img %}
    {% assign project_image_alt = project.img_alt | default: project.title | escape %}
    <div class="project-entry-image">
      {%
        include figure.liquid
        loading="lazy"
        path=project.img
        sizes="(min-width: 768px) 160px, (min-width: 480px) 120px, 100vw"
        alt=project_image_alt
      %}
    </div>
  {% endif %}
  <div class="project-entry-content">
    <h3 class="project-entry-title">
      <a href="{{ project_href }}">
        {{- project.title | escape }}
        <span aria-hidden="true">↗</span></a
      >
    </h3>
    <p class="project-entry-description">{{ project.description }}</p>
    {% if project.github %}
      <div class="project-entry-resources">
        <a href="{{ project.github }}" aria-label="Source code for {{ project.title | escape }}">
          <i class="fa-brands fa-github" aria-hidden="true"></i> Source code
        </a>
        {% if project.github_stars %}
          <span class="project-entry-stars" aria-label="GitHub stars">
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <span id="{{ project.github_stars }}-stars"></span>
          </span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>
