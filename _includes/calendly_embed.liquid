{% if site.calendly_url %}
  {% assign embed_height = include.height | default: '700px' %}
  <div
    class="calendly-inline-widget"
    data-url="{{ site.calendly_url }}?hide_event_type_details=0&hide_gdpr_banner=1"
    style="min-width: 320px; height: {{ embed_height }};"
  ></div>
  <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>

  <p class="text-muted small mt-2">
    Booking widget not loading? Open it directly on
    <a href="{{ site.calendly_url }}" target="_blank" rel="noopener">Calendly</a>.
  </p>
{% else %}
  <p class="text-muted">Booking link not configured yet — set <code>calendly_url</code> in <code>_config.yml</code>.</p>
{% endif %}
