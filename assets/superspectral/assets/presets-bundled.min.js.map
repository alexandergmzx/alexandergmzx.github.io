export default "{\n  \"analysis\": {\n    \"averaging\": \"exponential\",\n    \"db_reference\": \"dbfs_sine\",\n    \"dc_blocker_hz\": 20,\n    \"decimations\": 0,\n    \"fft_size\": 8192,\n    \"hold\": \"none\",\n    \"interval_ms\": 40,\n    \"resolution\": {\n      \"bin_width_hz\": 3.90625,\n      \"enbw_hz\": 7.829504,\n      \"hop_samples\": 1280,\n      \"window_duration_ms\": 256.0\n    },\n    \"sample_rate_hz\": 32000,\n    \"smoothing\": 0.15,\n    \"spectrum_type\": \"power_spectrum\",\n    \"weighting\": \"Z\",\n    \"window\": {\n      \"coefficients\": [\n        0.35875,\n        0.48829,\n        0.14128,\n        0.01168\n      ],\n      \"coherent_gain\": 0.35875,\n      \"coherent_gain_db\": -8.904162,\n      \"enbw_bins\": 2.004353,\n      \"form\": \"periodic\",\n      \"name\": \"blackman_harris\"\n    }\n  },\n  \"description\": \"Long Blackman-Harris window for steadiness work: vibrato rate and extent on a held note, where sidelobe suppression matters more than time resolution.\",\n  \"display\": {\n    \"db_ceiling_dbfs\": 0,\n    \"db_floor_dbfs\": -90,\n    \"freq_max_hz\": 8000,\n    \"freq_min_hz\": 60,\n    \"freq_scale\": \"log\",\n    \"overlays\": [\n      \"f0\",\n      \"vibrato_rate\",\n      \"peak_markers\"\n    ],\n    \"refresh_hz_target\": 25\n  },\n  \"guidance\": \"Held note, one breath per trial. The 25 Hz frame rate samples a 5-7 Hz vibrato about four times per cycle; faster modulation is not resolved by this preset.\",\n  \"id\": \"sustained_pitch_lab\",\n  \"mic_eq\": {\n    \"mode\": \"none\"\n  },\n  \"name\": \"Sustained pitch lab\",\n  \"provisional\": [\n    \"/analysis/dc_blocker_hz\",\n    \"/display/db_floor_dbfs\"\n  ],\n  \"schema_version\": \"1.0.0\",\n  \"targets\": [\n    \"watch\",\n    \"host\"\n  ]\n}\n"