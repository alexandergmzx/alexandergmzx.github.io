export default "{\n  \"analysis\": {\n    \"averaging\": \"exponential\",\n    \"db_reference\": \"dbfs_sine\",\n    \"dc_blocker_hz\": 20,\n    \"decimations\": 0,\n    \"fft_size\": 4096,\n    \"hold\": \"none\",\n    \"interval_ms\": 20,\n    \"resolution\": {\n      \"bin_width_hz\": 7.8125,\n      \"enbw_hz\": 15.659008,\n      \"hop_samples\": 640,\n      \"window_duration_ms\": 128.0\n    },\n    \"sample_rate_hz\": 32000,\n    \"smoothing\": 0.25,\n    \"spectrum_type\": \"power_spectrum\",\n    \"weighting\": \"Z\",\n    \"window\": {\n      \"coefficients\": [\n        0.35875,\n        0.48829,\n        0.14128,\n        0.01168\n      ],\n      \"coherent_gain\": 0.35875,\n      \"coherent_gain_db\": -8.904162,\n      \"enbw_bins\": 2.004353,\n      \"form\": \"periodic\",\n      \"name\": \"blackman_harris\"\n    }\n  },\n  \"description\": \"Waterfall-first preset for singing at full tempo: the shortest window that still resolves adjacent harmonics at a soprano f0, at the display's 50 Hz ceiling.\",\n  \"display\": {\n    \"db_ceiling_dbfs\": 0,\n    \"db_floor_dbfs\": -90,\n    \"freq_max_hz\": 8000,\n    \"freq_min_hz\": 60,\n    \"freq_scale\": \"log\",\n    \"overlays\": [\n      \"f0\",\n      \"peak_markers\",\n      \"ring_band\",\n      \"clipping\"\n    ],\n    \"refresh_hz_target\": 50\n  },\n  \"guidance\": \"Wrist at the validation matrix distance (15-45 cm from the mouth), arm angle recorded. Clipping is flagged, never tamed: back off if the flag latches.\",\n  \"id\": \"live_singing\",\n  \"mic_eq\": {\n    \"mode\": \"none\"\n  },\n  \"name\": \"Live singing\",\n  \"provisional\": [\n    \"/analysis/dc_blocker_hz\",\n    \"/display/db_floor_dbfs\"\n  ],\n  \"schema_version\": \"1.0.0\",\n  \"targets\": [\n    \"watch\",\n    \"host\"\n  ]\n}\n"