export default "{\n  \"analysis\": {\n    \"averaging\": \"linear\",\n    \"averaging_frames\": 25,\n    \"db_reference\": \"dbfs_sine\",\n    \"dc_blocker_hz\": 20,\n    \"decimations\": 0,\n    \"fft_size\": 8192,\n    \"hold\": \"min\",\n    \"interval_ms\": 40,\n    \"resolution\": {\n      \"bin_width_hz\": 3.90625,\n      \"enbw_hz\": 5.859375,\n      \"hop_samples\": 1280,\n      \"window_duration_ms\": 256.0\n    },\n    \"sample_rate_hz\": 32000,\n    \"smoothing\": 0.0,\n    \"spectrum_type\": \"psd\",\n    \"weighting\": \"A\",\n    \"window\": {\n      \"coefficients\": [\n        0.5,\n        0.5\n      ],\n      \"coherent_gain\": 0.5,\n      \"coherent_gain_db\": -6.0206,\n      \"enbw_bins\": 1.5,\n      \"form\": \"periodic\",\n      \"name\": \"hann\"\n    }\n  },\n  \"description\": \"Linear (Welch-style) averaging with min-hold and A-weighting: what the room and the instrument contribute before anyone sings.\",\n  \"display\": {\n    \"db_ceiling_dbfs\": 0,\n    \"db_floor_dbfs\": -100,\n    \"freq_max_hz\": 12800,\n    \"freq_min_hz\": 20,\n    \"freq_scale\": \"log\",\n    \"overlays\": [\n      \"leq\"\n    ],\n    \"refresh_hz_target\": 25\n  },\n  \"guidance\": \"Silence in the room, watch still, no hand movement across the port. The reading is relative dBFS, not dB SPL: no calibrator is in the chain.\",\n  \"id\": \"room_noise_floor\",\n  \"mic_eq\": {\n    \"mode\": \"none\"\n  },\n  \"name\": \"Room noise floor\",\n  \"provisional\": [\n    \"/analysis/dc_blocker_hz\",\n    \"/display/db_floor_dbfs\",\n    \"/display/freq_max_hz\"\n  ],\n  \"schema_version\": \"1.0.0\",\n  \"targets\": [\n    \"watch\",\n    \"host\"\n  ]\n}\n"