export default "{\n  \"analysis\": {\n    \"averaging\": \"none\",\n    \"db_reference\": \"dbfs_sine\",\n    \"dc_blocker_hz\": 20,\n    \"decimations\": 0,\n    \"fft_size\": 1024,\n    \"hold\": \"none\",\n    \"interval_ms\": 10,\n    \"resolution\": {\n      \"bin_width_hz\": 31.25,\n      \"enbw_hz\": 46.875,\n      \"hop_samples\": 320,\n      \"window_duration_ms\": 32.0\n    },\n    \"sample_rate_hz\": 32000,\n    \"smoothing\": 0.0,\n    \"spectrum_type\": \"power_spectrum\",\n    \"weighting\": \"Z\",\n    \"window\": {\n      \"coefficients\": [\n        0.5,\n        0.5\n      ],\n      \"coherent_gain\": 0.5,\n      \"coherent_gain_db\": -6.0206,\n      \"enbw_bins\": 1.5,\n      \"form\": \"periodic\",\n      \"name\": \"hann\"\n    }\n  },\n  \"description\": \"Short window and a 10 ms hop for transient work - plosive bursts and fricative noise bands. Two spectrogram columns per rendered frame.\",\n  \"display\": {\n    \"db_ceiling_dbfs\": 0,\n    \"db_floor_dbfs\": -90,\n    \"freq_max_hz\": 12800,\n    \"freq_min_hz\": 100,\n    \"freq_scale\": \"log\",\n    \"overlays\": [\n      \"peak_markers\",\n      \"clipping\"\n    ],\n    \"refresh_hz_target\": 50\n  },\n  \"guidance\": \"Speak or sing text at performance loudness; plosives at close range clip easily, so watch the clipping flag rather than the level meter.\",\n  \"id\": \"diction_consonants\",\n  \"mic_eq\": {\n    \"mode\": \"none\"\n  },\n  \"name\": \"Diction and consonants\",\n  \"provisional\": [\n    \"/analysis/dc_blocker_hz\",\n    \"/display/db_floor_dbfs\",\n    \"/display/freq_max_hz\"\n  ],\n  \"schema_version\": \"1.0.0\",\n  \"targets\": [\n    \"watch\",\n    \"host\"\n  ]\n}\n"