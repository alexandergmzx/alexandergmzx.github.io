export default "{\n  \"analysis\": {\n    \"averaging\": \"none\",\n    \"db_reference\": \"dbfs_sine\",\n    \"dc_blocker_hz\": 20,\n    \"decimations\": 0,\n    \"fft_size\": 8192,\n    \"hold\": \"none\",\n    \"interval_ms\": 10,\n    \"resolution\": {\n      \"bin_width_hz\": 5.859375,\n      \"enbw_hz\": 8.789062,\n      \"hop_samples\": 480,\n      \"window_duration_ms\": 170.666667\n    },\n    \"sample_rate_hz\": 48000,\n    \"smoothing\": 0.0,\n    \"spectrum_type\": \"power_spectrum\",\n    \"weighting\": \"Z\",\n    \"window\": {\n      \"coefficients\": [\n        0.5,\n        0.5\n      ],\n      \"coherent_gain\": 0.5,\n      \"coherent_gain_db\": -6.0206,\n      \"enbw_bins\": 1.5,\n      \"form\": \"periodic\",\n      \"name\": \"hann\"\n    }\n  },\n  \"description\": \"Offline comparison of a recorded take against an isolated reference vocal stem: LTAS, SPR and an f0 overlay after DTW alignment. Never runs on the watch.\",\n  \"display\": {\n    \"db_ceiling_dbfs\": 0,\n    \"db_floor_dbfs\": -100,\n    \"freq_max_hz\": 16000,\n    \"freq_min_hz\": 60,\n    \"freq_scale\": \"log\",\n    \"overlays\": [\n      \"stem_f0\",\n      \"dtw_path\",\n      \"ltas\",\n      \"spr\"\n    ]\n  },\n  \"guidance\": \"Both signals must come from the same take geometry to be comparable; stem separation artefacts propagate into f0 and formant tracks, so validate against the full mix too.\",\n  \"host\": {\n    \"align\": \"dtw_chroma\",\n    \"reference\": \"stem\",\n    \"separation\": \"demucs_htdemucs_ft\"\n  },\n  \"id\": \"stem_analysis\",\n  \"mic_eq\": {\n    \"mode\": \"none\"\n  },\n  \"name\": \"Stem analysis (host only)\",\n  \"provisional\": [\n    \"/analysis/dc_blocker_hz\",\n    \"/display/db_floor_dbfs\"\n  ],\n  \"schema_version\": \"1.0.0\",\n  \"targets\": [\n    \"host\"\n  ]\n}\n"